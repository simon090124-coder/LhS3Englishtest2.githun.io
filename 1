<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>闪卡记忆 - Flashcard Master</title>
  <style>
    :root {
      --bg-color: #0f172a;
      --card-bg: #1e293b;
      --card-border: #334155;
      --text-main: #f8fafc;
      --text-sub: #94a3b8;
      --accent: #6366f1;
      --accent-hover: #4f46e5;
      --green: #10b981;
      --red: #ef4444;
      --red-hover: #dc2626;
      --green-hover: #059669;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background-color: var(--bg-color);
      color: var(--text-main);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      overflow-x: hidden;
    }

    #app {
      width: 100%;
      max-width: 420px;
      height: 100vh;
      max-height: 860px;
      display: flex;
      flex-direction: column;
      position: relative;
      background: #0f172a;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
      overflow: hidden;
    }

    @media (min-height: 800px) and (min-width: 430px) {
      #app {
        height: 92vh;
        border-radius: 32px;
        border: 1px solid var(--card-border);
      }
    }

    /* 头部 Header */
    .header {
      padding: 18px 20px 10px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 10;
    }

    .icon-btn {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      color: var(--text-main);
      width: 40px;
      height: 40px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 18px;
      transition: all 0.2s;
    }

    .icon-btn:active {
      transform: scale(0.92);
    }

    .deck-title {
      font-size: 18px;
      font-weight: 700;
      color: var(--text-main);
      text-align: center;
      flex: 1;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      margin: 0 10px;
    }

    /* 视图切换 */
    .view {
      display: none;
      flex-direction: column;
      flex: 1;
      padding: 10px 20px 20px;
      position: relative;
      height: calc(100% - 68px);
    }

    .view.active {
      display: flex;
    }

    /* 1. 首页 Deck Selection */
    .deck-list {
      flex: 1;
      overflow-y: auto;
      margin-top: 10px;
      padding-right: 4px;
    }

    .deck-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 18px;
      padding: 18px 20px;
      margin-bottom: 14px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: pointer;
      transition: all 0.2s;
    }

    .deck-card:active {
      transform: scale(0.98);
      border-color: var(--accent);
    }

    .deck-info h3 {
      font-size: 18px;
      margin-bottom: 4px;
    }

    .deck-info p {
      font-size: 13px;
      color: var(--text-sub);
    }

    .start-btn-sm {
      background: var(--accent);
      color: white;
      border: none;
      padding: 8px 16px;
      border-radius: 10px;
      font-weight: 600;
      font-size: 14px;
    }

    .add-deck-btn {
      background: transparent;
      border: 2px dashed var(--card-border);
      color: var(--text-sub);
      border-radius: 18px;
      padding: 16px;
      width: 100%;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
      margin-top: 5px;
    }

    /* 2. 复习卡片界面 */
    .progress-bar-container {
      width: 100%;
      height: 6px;
      background: var(--card-bg);
      border-radius: 10px;
      overflow: hidden;
      margin-bottom: 16px;
    }

    .progress-bar {
      height: 100%;
      background: linear-gradient(90deg, var(--accent), #818cf8);
      width: 0%;
      transition: width 0.3s ease;
    }

    .card-container {
      flex: 1;
      perspective: 1000px;
      display: flex;
      justify-content: center;
      align-items: center;
      margin-bottom: 20px;
    }

    .flashcard {
      width: 100%;
      height: 100%;
      max-height: 420px;
      position: relative;
      transform-style: preserve-3d;
      transition: transform 0.6s cubic-bezier(0.4, 0.2, 0.2, 1);
      cursor: pointer;
    }

    .flashcard.flipped {
      transform: rotateY(180deg);
    }

    .card-face {
      position: absolute;
      width: 100%;
      height: 100%;
      backface-visibility: hidden;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 24px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 24px;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3);
      text-align: center;
    }

    .card-back {
      transform: rotateY(180deg);
      background: #1c2333;
    }

    .word-text {
      font-size: 32px;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 8px;
      word-break: break-word;
    }

    .pos-tag {
      display: inline-block;
      font-size: 12px;
      background: rgba(99, 102, 241, 0.2);
      color: #818cf8;
      padding: 3px 8px;
      border-radius: 6px;
      margin-bottom: 12px;
      font-weight: 600;
    }

    .phonetic {
      font-size: 15px;
      color: var(--text-sub);
      margin-bottom: 16px;
    }

    .audio-btn {
      background: rgba(255, 255, 255, 0.08);
      border: none;
      color: var(--text-main);
      width: 44px;
      height: 44px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 20px;
      transition: background 0.2s;
    }

    .audio-btn:hover {
      background: rgba(255, 255, 255, 0.15);
    }

    .flip-hint {
      position: absolute;
      bottom: 20px;
      font-size: 12px;
      color: var(--text-sub);
      opacity: 0.6;
    }

    .meaning {
      font-size: 22px;
      font-weight: 600;
      color: #4ade80;
      margin-bottom: 16px;
    }

    /* 底部按钮控制区 */
    .controls {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      height: 64px;
    }

    .btn-action {
      border: none;
      border-radius: 16px;
      font-size: 18px;
      font-weight: 700;
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      cursor: pointer;
      transition: all 0.2s;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.2);
    }

    .btn-know {
      background: var(--green);
    }
    .btn-know:active {
      background: var(--green-hover);
      transform: scale(0.96);
    }

    .btn-forgot {
      background: var(--red);
    }
    .btn-forgot:active {
      background: var(--red-hover);
      transform: scale(0.96);
    }

    /* 3. 结算界面 */
    .summary-box {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
    }

    .summary-icon {
      font-size: 64px;
      margin-bottom: 16px;
    }

    .summary-title {
      font-size: 24px;
      font-weight: 700;
      margin-bottom: 8px;
    }

    .summary-stats {
      display: flex;
      gap: 20px;
      margin: 24px 0;
      width: 100%;
    }

    .stat-card {
      flex: 1;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 16px;
      padding: 16px;
    }

    .stat-num {
      font-size: 28px;
      font-weight: 700;
    }
    .stat-num.green { color: var(--green); }
    .stat-num.red { color: var(--red); }

    .stat-label {
      font-size: 13px;
      color: var(--text-sub);
      margin-top: 4px;
    }

    .summary-actions {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .btn-primary {
      background: var(--accent);
      color: white;
      border: none;
      padding: 16px;
      border-radius: 16px;
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s;
    }

    .btn-secondary {
      background: var(--card-bg);
      color: var(--text-main);
      border: 1px solid var(--card-border);
      padding: 16px;
      border-radius: 16px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
    }

    /* 4. 弹窗 Modal */
    .modal {
      display: none;
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(4px);
      z-index: 100;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }

    .modal.active {
      display: flex;
    }

    .modal-content {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: 20px;
      width: 100%;
      max-width: 360px;
      padding: 24px;
    }

    .modal-title {
      font-size: 18px;
      font-weight: 700;
      margin-bottom: 16px;
    }

    .modal-input, .modal-textarea {
      width: 100%;
      background: var(--bg-color);
      border: 1px solid var(--card-border);
      color: var(--text-main);
      padding: 12px;
      border-radius: 10px;
      margin-bottom: 12px;
      font-size: 14px;
    }

    .modal-textarea {
      height: 120px;
      resize: none;
    }

    .modal-btns {
      display: flex;
      gap: 10px;
      justify-content: flex-end;
    }

    .btn-text {
      background: transparent;
      border: none;
      color: var(--text-sub);
      padding: 8px 16px;
      font-size: 14px;
      cursor: pointer;
    }

    .btn-text.primary {
      color: var(--accent);
      font-weight: 700;
    }

    .format-hint {
      font-size: 11px;
      color: var(--text-sub);
      margin-bottom: 12px;
      line-height: 1.4;
    }
  </style>
</head>
<body>

<div id="app">
  <!-- 头部导航 -->
  <div class="header">
    <button class="icon-btn" id="backBtn" style="visibility: hidden;">←</button>
    <div class="deck-title" id="headerTitle">闪卡记忆库</div>
    <button class="icon-btn" id="addWordBtn" style="visibility: hidden;">+</button>
  </div>

  <!-- 1. 词库选择界面 -->
  <div class="view active" id="deckView">
    <div class="deck-list" id="deckList">
      <!-- 动态插入词库 -->
    </div>
    <button class="add-deck-btn" id="createDeckBtn">+ 新建词库 (Import New Deck)</button>
  </div>

  <!-- 2. 卡片复习界面 -->
  <div class="view" id="reviewView">
    <div class="progress-bar-container">
      <div class="progress-bar" id="progressBar"></div>
    </div>

    <div class="card-container">
      <div class="flashcard" id="flashcard">
        <!-- 正面 -->
        <div class="card-face card-front">
          <div style="flex:1; display:flex; flex-direction:column; justify-content:center; align-items:center;">
            <div class="word-text" id="frontWord">loading...</div>
            <div>
              <span class="pos-tag" id="frontPos">adj.</span>
            </div>
            <div class="phonetic" id="frontPhonetic">/ /</div>
            <button class="audio-btn" id="audioBtn" onclick="event.stopPropagation(); playAudio();">🔊</button>
          </div>
          <div class="flip-hint">点击卡片翻面查看释义 👆</div>
        </div>
        <!-- 背面 -->
        <div class="card-face card-back">
          <div style="flex:1; display:flex; flex-direction:column; justify-content:center; align-items:center;">
            <div class="meaning" id="backMeaning">中文释义</div>
            <div style="font-size: 13px; color: var(--text-sub);" id="backWordRef">word</div>
          </div>
          <div class="flip-hint">点击卡片再次翻面 👆</div>
        </div>
      </div>
    </div>

    <div class="controls">
      <button class="btn-action btn-forgot" onclick="markCard(false)">✕ 不会</button>
      <button class="btn-action btn-know" onclick="markCard(true)">✓ 会了</button>
    </div>
  </div>

  <!-- 3. 本轮结束结算界面 -->
  <div class="view" id="summaryView">
    <div class="summary-box">
      <div class="summary-icon">🎉</div>
      <div class="summary-title">太棒了！完成本轮复习</div>
      <p style="color: var(--text-sub); font-size: 14px;">坚持复习是记牢生词的最佳途径</p>

      <div class="summary-stats">
        <div class="stat-card">
          <div class="stat-num green" id="statKnow">0</div>
          <div class="stat-label">已掌握</div>
        </div>
        <div class="stat-card">
          <div class="stat-num red" id="statForgot">0</div>
          <div class="stat-label">需要巩固</div>
        </div>
      </div>

      <div class="summary-actions">
        <button class="btn-primary" id="reviewForgotBtn" onclick="startReviewForgot()">仅复习“不会”的单词</button>
        <button class="btn-secondary" onclick="restartDeck()">重新复习全套词库</button>
        <button class="btn-secondary" onclick="switchView('deckView')" style="border:none; background:transparent; color: var(--text-sub);">返回词库列表</button>
      </div>
    </div>
  </div>

  <!-- 弹窗：创建新词库 -->
  <div class="modal" id="addDeckModal">
    <div class="modal-content">
      <div class="modal-title">新建词库</div>
      <input type="text" class="modal-input" id="deckNameInput" placeholder="词库名称 (如: Test Three / Unit 5)">
      <div class="format-hint">
        快速批量导入格式（每行一个）：<br>
        <b>单词 | 词性 | 音标 | 中文释义</b><br>
        例如：<br>
        futuristic | adj. | /ˈfjuː.tʃəˈrɪs.tɪk/ | 未来的，极现代化的
      </div>
      <textarea class="modal-textarea" id="deckWordsInput" placeholder="可以直接贴入上面的文本格式..."></textarea>
      <div class="modal-btns">
        <button class="btn-text" onclick="closeModal('addDeckModal')">取消</button>
        <button class="btn-text primary" onclick="saveNewDeck()">创建并保存</button>
      </div>
    </div>
  </div>
</div>

