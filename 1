        { word: "be similar to/ be the same as", pos: "phr.", phonetic: "", meaning: "类似/相同" },
        { word: "in the distance", pos: "phr.", phonetic: "", meaning: "在远处" },
        { word: "do cleaning/ go shopping", pos: "phr.", phonetic: "", meaning: "搞清洁/去购物" },
        { word: "be defined as", pos: "phr.", phonetic: "", meaning: "被定义为" },
        { word: "have (sth./ nothing) to do with", pos: "phr.", phonetic: "", meaning: "与...有关/无关" },
        { word: "do away with/ get rid of", pos: "phr.", phonetic: "", meaning: "消除" },
        { word: "drop in on sb.", pos: "phr.", phonetic: "", meaning: "顺便看望某人（某处）" },
        { word: "on duty", pos: "phr.", phonetic: "", meaning: "值班，值日" },
        { word: "make an experiment(s)", pos: "phr.", phonetic: "", meaning: "做实验" },
        { word: "be entitled to", pos: "phr.", phonetic: "", meaning: "有...的资格" },
        { word: "with ease", pos: "phr.", phonetic: "", meaning: "轻易地" },
        { word: "at ease", pos: "phr.", phonetic: "", meaning: "自由自在地" },
        { word: "make an effort (s)", pos: "phr.", phonetic: "", meaning: "做出努力" },
        { word: "without emotion", pos: "phr.", phonetic: "", meaning: "无动于衷" },
        { word: "lay/place emphasis on/ upon emphasize on", pos: "phr.", phonetic: "", meaning: "强调" },
        { word: "environmentally friendly", pos: "phr.", phonetic: "", meaning: "环保" },
        { word: "enjoy oneself / have a good time", pos: "phr.", phonetic: "", meaning: "过得快乐，玩得开心" },
        { word: "endanger one's life", pos: "phr.", phonetic: "", meaning: "危及生命" },
        { word: "expected salary", pos: "phr.", phonetic: "", meaning: "期望薪酬" },
        { word: "enforce the law", pos: "phr.", phonetic: "", meaning: "执行法律" },
        { word: "put an end to sth.", pos: "phr.", phonetic: "", meaning: "终止某事" },
        { word: "an entrance to...", pos: "phr.", phonetic: "", meaning: "在...人口" },
        { word: "engage in", pos: "phr.", phonetic: "", meaning: "从事于" },
        { word: "to a large extent", pos: "phr.", phonetic: "", meaning: "很大程度上" },
        { word: "the equality between sexes", pos: "phr.", phonetic: "", meaning: "男女平等" },
        { word: "be equipped with", pos: "phr.", phonetic: "", meaning: "用...装备" },
        { word: "examine one's eyes", pos: "phr.", phonetic: "", meaning: "检查眼睛" },
        { word: "have a physical examination", pos: "phr.", phonetic: "", meaning: "进行体检" },
        { word: "set an example to", pos: "phr.", phonetic: "", meaning: "为...树立榜样" },
        { word: "follow one's example", pos: "phr.", phonetic: "", meaning: "以...为榜样" },
        { word: "exhibit one's courage", pos: "phr.", phonetic: "", meaning: "表现出勇气" },
        { word: "explain to sb. for sth.", pos: "phr.", phonetic: "", meaning: "向某人解释某事" }
      ]
    }
  };

  // 应用状态管理
  let decks = JSON.parse(localStorage.getItem('flashcard_decks')) || defaultDecks;
  let currentDeckId = null;
  let currentQueue = [];
  let currentIndex = 0;
  let knowList = [];
  let forgotList = [];
  let isFlipped = false;

  // DOM 节点引用
  const deckView = document.getElementById('deckView');
  const reviewView = document.getElementById('reviewView');
  const summaryView = document.getElementById('summaryView');
  const headerTitle = document.getElementById('headerTitle');
  const backBtn = document.getElementById('backBtn');
  const flashcard = document.getElementById('flashcard');

  // 初始化
  function init() {
    saveToStorage();
    renderDecks();

    document.getElementById('createDeckBtn').addEventListener('click', () => {
      document.getElementById('addDeckModal').classList.add('active');
    });

    backBtn.addEventListener('click', () => {
      switchView('deckView');
    });

    flashcard.addEventListener('click', () => {
      isFlipped = !isFlipped;
      flashcard.classList.toggle('flipped', isFlipped);
    });
  }

  function saveToStorage() {
    localStorage.setItem('flashcard_decks', JSON.stringify(decks));
  }

  function renderDecks() {
    const deckList = document.getElementById('deckList');
    deckList.innerHTML = '';

    Object.values(decks).forEach(deck => {
      const card = document.createElement('div');
      card.className = 'deck-card';
      card.innerHTML = `
        <div class="deck-info">
          <h3>${deck.name}</h3>
          <p>${deck.words.length} 个词汇 / 短语</p>
        </div>
        <button class="start-btn-sm">开始复习</button>
      `;
      card.onclick = () => startDeck(deck.id);
      deckList.appendChild(card);
    });
  }

  function switchView(viewName) {
    [deckView, reviewView, summaryView].forEach(v => v.classList.remove('active'));

    if (viewName === 'deckView') {
      deckView.classList.add('active');
      headerTitle.textContent = "闪卡记忆库";
      backBtn.style.visibility = 'hidden';
      renderDecks();
    } else if (viewName === 'reviewView') {
      reviewView.classList.add('active');
      headerTitle.textContent = decks[currentDeckId].name;
      backBtn.style.visibility = 'visible';
    } else if (viewName === 'summaryView') {
      summaryView.classList.add('active');
      headerTitle.textContent = "复习完成";
      backBtn.style.visibility = 'visible';
    }
  }

  function startDeck(deckId) {
    currentDeckId = deckId;
    currentQueue = [...decks[deckId].words];
    currentIndex = 0;
    knowList = [];
    forgotList = [];
    switchView('reviewView');
    loadCard();
  }

  function loadCard() {
    if (currentIndex >= currentQueue.length) {
      showSummary();
      return;
    }

    isFlipped = false;
    flashcard.classList.remove('flipped');

    const item = currentQueue[currentIndex];
    
    // 更新内容
    document.getElementById('frontWord').textContent = item.word;
    document.getElementById('frontPos').textContent = item.pos || 'word';
    document.getElementById('frontPhonetic').textContent = item.phonetic || '';
    document.getElementById('backMeaning').textContent = item.meaning;
    document.getElementById('backWordRef').textContent = item.word;

    // 隐藏/显示音标
    document.getElementById('frontPhonetic').style.display = item.phonetic ? 'block' : 'none';

    // 进度条更新
    const progressPct = ((currentIndex) / currentQueue.length) * 100;
    document.getElementById('progressBar').style.width = `${progressPct}%`;
  }

  function markCard(isKnow) {
    const currentWord = currentQueue[currentIndex];
    if (isKnow) {
      knowList.push(currentWord);
    } else {
      forgotList.push(currentWord);
    }

    currentIndex++;
    loadCard();
  }

  function showSummary() {
    document.getElementById('progressBar').style.width = '100%';
    document.getElementById('statKnow').textContent = knowList.length;
    document.getElementById('statForgot').textContent = forgotList.length;

    const reviewForgotBtn = document.getElementById('reviewForgotBtn');
    if (forgotList.length === 0) {
      reviewForgotBtn.style.display = 'none';
    } else {
      reviewForgotBtn.style.display = 'block';
    }

    switchView('summaryView');
  }

  function startReviewForgot() {
    currentQueue = [...forgotList];
    currentIndex = 0;
    knowList = [];
    forgotList = [];
    switchView('reviewView');
    loadCard();
  }

  function restartDeck() {
    startDeck(currentDeckId);
  }

  function playAudio() {
    const word = currentQueue[currentIndex]?.word;
    if (!word) return;
    const utterance = new SpeechSynthesisUtterance(word);
    utterance.lang = 'en-US';
    window.speechSynthesis.speak(utterance);
  }

  function closeModal(id) {
    document.getElementById(id).classList.remove('active');
  }

  function saveNewDeck() {
    const name = document.getElementById('deckNameInput').value.trim();
    const rawText = document.getElementById('deckWordsInput').value.trim();

    if (!name) {
      alert('请输入词库名称');
      return;
    }

    const lines = rawText.split('\n');
    const words = [];

    lines.forEach(line => {
      if (!line.trim()) return;
      const parts = line.split('|').map(s => s.trim());
      if (parts.length >= 2) {
        words.push({
          word: parts[0],
          pos: parts[1] || '',
          phonetic: parts[2] || '',
          meaning: parts[3] || parts[1] // 如果只传了 2 个参数，第2个作为中文
        });
      } else {
        // 普通格式兼容
        words.push({
          word: line.trim(),
          pos: '',
          phonetic: '',
          meaning: '未添加释义'
        });
      }
    });

    if (words.length === 0) {
      alert('请输入有效生词');
      return;
    }

    const newId = 'deck_' + Date.now();
    decks[newId] = {
      id: newId,
      name: name,
      words: words
    };

    saveToStorage();
    closeModal('addDeckModal');
    document.getElementById('deckNameInput').value = '';
    document.getElementById('deckWordsInput').value = '';
    renderDecks();
  }

  // 页面启动
  init();
</script>
</body>
</html>
